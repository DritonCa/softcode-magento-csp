<?xml version="1.0"?>
<!--
    This module manages CSP whitelist hosts from the admin (Stores > Configuration
    > Softcode > CSP), not from static XML. The file is intentionally shipped
    without policies so the module carries no environment- or customer-specific
    hosts. Add hosts through the admin grid, where they are validated and
    deduplicated, or declare fixed project defaults here if needed.
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies/>
</csp_whitelist>
